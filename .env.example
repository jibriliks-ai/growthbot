# ============================================================
# GrowthBot SaaS — Environment Variables Template
# ============================================================
# Copy this file to `.env` for local development:
#   cp .env.example .env
# Then fill in real values. NEVER commit `.env` to GitHub.
# On Render, add these as Environment Variables in the dashboard.
# ============================================================

# ===== App =====
NODE_ENV=development
PORT=10000
APP_NAME=GrowthBot
FRONTEND_URL=http://localhost:10000

# ===== Product Limits (business rules, change freely) =====
FREE_AUDITS_PER_DAY=3
PREMIUM_VIDEOS_PER_MONTH=30
PREMIUM_BACKLINKS_PER_DAY=10
PREMIUM_PRICE_NGN=5000

# ===== PostgreSQL Database =====
# Local dev: postgresql://postgres:postgres@localhost:5432/growthbot
# Render:    copy "External Database URL" from Render Postgres dashboard
DATABASE_URL=postgresql://user:password@host:5432/growthbot

# ===== Flutterwave (payment gateway) =====
# Get from: https://dashboard.flutterwave.com/settings/apis
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-x
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-x

# Create your own Secret Hash at:
# https://dashboard.flutterwave.com/settings/webhooks
# (type any strong random string — Flutterwave uses it to sign webhooks)
FLUTTERWAVE_SECRET_HASH=change_me_to_a_long_random_string

# The URL you must paste into the Flutterwave webhook field:
# Development: use ngrok → https://xxxx.ngrok.io/api/webhook/flutterwave
# Production:  https://YOUR-APP.onrender.com/api/webhook/flutterwave
FLUTTERWAVE_WEBHOOK_URL=http://localhost:10000/api/webhook/flutterwave

# ===== IndexNow (search engine indexing) =====
# No signup required. Any random 32-character hex string works.
# Generate one: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# After generating, host a text file at: https://YOUR-DOMAIN/{INDEXNOW_KEY}.txt
#   whose ONLY content is the key itself.
INDEXNOW_KEY=

# ===== Video Engine =====
# Script generation: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Stock footage:      https://www.pexels.com/api/
PEXELS_API_KEY=...

# Voiceover:          https://elevenlabs.io/subscription
ELEVENLABS_API_KEY=...

# Video rendering:    https://dashboard.shotstack.io/keys
SHOTSTACK_API_KEY=...
SHOTSTACK_ENV=v1